# =====================================================================
# ORPHEUS AI Brain - Environment Configuration Template
# =====================================================================

# Primary LLM Provider: Groq Cloud API (Low latency, 3.0s bounded timeout)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# LLM Provider selection: 'groq' (primary) with automatic pre-authored fallback
# (Ollama is completely removed from runtime to guarantee zero offline latency)
LLM_PROVIDER=groq

# Audio Voice Playback: 'on' or 'off' (set to 'off' for subtitle-only mode)
VOICE=off

# Server Host & Port (called by Unreal Engine HTTP Blueprint)
HOST=127.0.0.1
PORT=8000

# Server Restart Persistence (saves state to JSON file across process restarts)
ENABLE_DISK_PERSISTENCE=false

# Authoritative Evidence Discovery Mode (requires discovery via /event before presentation)
ENABLE_STRICT_EVIDENCE_DISCOVERY=true
