# =====================================================================
# ORPHEUS AI Brain - Environment Configuration Template
# =====================================================================

# Primary LLM Provider: Groq Cloud API
# Get your free key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# LLM Provider selection: 'groq' (primary) or 'ollama' (offline fallback)
LLM_PROVIDER=groq

# Local Ollama Configuration (for offline backup)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Audio Voice Playback: 'on' or 'off' (set to 'off' for subtitle-only mode)
VOICE=off

# Server Host & Port
HOST=127.0.0.1
PORT=8000
